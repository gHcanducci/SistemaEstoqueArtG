<Window x:Class="SistemaEstoque.RegistrarSaidaWindow"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Registrar Saída de Produto"
        Height="500" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#FF011945">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0">
            <Image HorizontalAlignment="Left" Height="59" Margin="-20,-20,0,0" VerticalAlignment="Top" Width="105" Source="/LogoArtG.jpeg"/>
            <TextBlock Text="Registrar Saída de Produto"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#FFABC2E4"
                       VerticalAlignment="Top"
                       Margin="96,-5,24,0"/>
        </Grid>

        <!-- Conteúdo -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">

                <!-- PRODUTO -->
                <TextBlock Text="Produto" Foreground="#011945" FontWeight="Bold"/>
                <ComboBox x:Name="cbProduto"
                          Height="25" Margin="0,5,0,5"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Nome"
                          DisplayMemberPath="Nome"
                          SelectedValuePath="Id"/>

                <!-- QUANTIDADE -->
                <TextBlock Text="Quantidade" Foreground="#011945" FontWeight="Bold"/>
                <TextBox x:Name="txtQuantidade" Height="25" Margin="0,5,0,5"/>

                <!-- DATA DA SAÍDA -->
                <TextBlock Text="Data da Saída" Foreground="#011945" FontWeight="Bold"/>
                <DatePicker x:Name="dpDataSaida" Height="25" Margin="0,5,0,5" SelectedDate="{x:Static sys:DateTime.Now}">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                <!-- MOTIVO (TIPO DE SAÍDA) -->
                <TextBlock Text="Motivo da Saída" Foreground="#011945" FontWeight="Bold"/>
                <TextBox x:Name="txtTipoSaida" Height="25" Margin="0,5,0,5"/>

                <!-- RESPONSÁVEL -->
                <TextBlock Text="Funcionário Responsável" Foreground="#011945" FontWeight="Bold"/>
                <ComboBox x:Name="cbResponsavel"
                          Height="25" Margin="0,5,0,15"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Nome"
                          DisplayMemberPath="Nome"
                          SelectedValuePath="Id"/>

                <!-- REPOSIÇÃO -->
                <CheckBox x:Name="chkReposicao" Content="Necessita Reposição?" Foreground="#011945" FontWeight="Bold" Margin="0,0,0,15"/>


                <!-- BOTÕES -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Salvar"
                            Width="100" Height="25"
                            Background="#27AE60"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            Click="Salvar_Click"/>
                    <Button Content="Cancelar"
                            Width="100" Height="25"
                            Background="#DC0000"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Cancelar_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>