<Window x:Class="SistemaEstoque.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login - Sistema de Gerenciamento de Estoque"
        Height="450" Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF011945">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Logo no canto superior esquerdo -->
        <Image Source="/LogoArtG.jpeg"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="-18,-18,0,0"
               Width="106"
               Height="61"/>

        <!-- Lado esquerdo decorativo -->
        <Grid Grid.Column="0" Margin="0,30,0,0">
            <StackPanel VerticalAlignment="Center" Margin="10">
                <TextBlock Text="Bem-vindo ao"
                           FontSize="20"
                           Foreground="#FFADC1E4"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Sistema de Gerenciamento de Estoque"
                           FontSize="24"
                           Foreground="White"
                           TextWrapping="Wrap"
                           FontWeight="Bold"/>
                <TextBlock Text="Faça login para continuar"
                           FontSize="14"
                           Foreground="#FFD0D6E0"
                           FontWeight="Light"
                           Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Lado direito (formulário de login) -->
        <Border Grid.Column="1"
                CornerRadius="15"
                Background="White"
                Padding="30"
                Margin="20,40,40,40">

            <!-- Sombra (WPF nativo) -->
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="🔐 Login"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center" Height="27"/>

                <TextBlock Text="Usuário" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsuario"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="8"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         Background="#F8F9FA"/>

                <TextBlock Text="Senha" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtSenha"
                             Height="35"
                             Margin="0,0,0,25"
                             Padding="8"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"
                             Background="#F8F9FA"/>

                <Button Content="Entrar"
                        Height="40"
                        Background="#3498DB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="BtnEntrar_Click"/>

                <TextBlock Text="Esqueceu sua senha?"
                           Foreground="#2980B9"
                           FontSize="12"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>