<Window x:Class="SistemaEstoque.GerenciarEntradasSaidasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar Entradas e Saídas"
        Height="500" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#FF011945">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,15">
            <Image Source="/LogoArtG.jpeg" Height="50" Width="85" Margin="0,0,10,0"/>
            <TextBlock Text="Gerenciamento de Entradas e Saídas"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#FFADC1E4"/>
        </StackPanel>

        <!-- Área de Filtros -->
        <Border Background="White" CornerRadius="10" Padding="15" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Produto -->
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Produto:" FontWeight="Bold" Foreground="#2D2D2D"/>
                    <ComboBox x:Name="cbProduto" Height="30" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Tipo -->
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Tipo de Movimentação:" FontWeight="Bold" Foreground="#2D2D2D"/>
                    <ComboBox x:Name="cbTipo" Height="30" Margin="0,5,0,0">
                        <ComboBoxItem Content="Entradas"/>
                        <ComboBoxItem Content="Saídas"/>
                    </ComboBox>
                </StackPanel>

                <!-- Botão Consultar -->
                <StackPanel Grid.Column="2" Margin="5" VerticalAlignment="Bottom">
                    <Button Content="Consultar"
                            Background="#3498DB"
                            Foreground="White"
                            Height="35"
                            BorderThickness="0"
                            Click="Consultar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid de Movimentações -->
        <Border Background="White" CornerRadius="10" Padding="15" Grid.Row="2" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="Movimentações Encontradas"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           Foreground="#2D2D2D"/>
                <DataGrid x:Name="dgMovimentacoes"
          Grid.Row="4"
          Margin="0,10,0,0"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          AlternatingRowBackground="#FFF8F8F8"
          HeadersVisibility="Column"
          CanUserAddRows="False">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="150"/>
                        <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="100"/>
                        <DataGridTextColumn Header="Tipo de Saída" Binding="{Binding TipoSaida}" Width="350"/>
                        <!-- ✅ NOVO -->
                        <DataGridTextColumn Header="Responsável" Binding="{Binding Responsavel}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Botão Voltar -->
                <Button Content="Voltar"
                        HorizontalAlignment="Right"
                        Width="100"
                        Height="35"
                        Margin="0,15,0,0"
                        Background="#E67E22"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Voltar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>