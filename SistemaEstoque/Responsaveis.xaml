<Page x:Class="SistemaEstoque.Responsaveis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SistemaEstoque"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Responsaveis" Height="450" Width="800" Background="#FF011945">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock FontSize="20" FontWeight="Bold" Margin="0,-3,0,13" Background="#FF011945" Foreground="#FFADC0E4"><Run Language="pt-br" Text="&#x9;"/><Run Text=" Cadastro e Consulta de Responsáveis"/></TextBlock>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulário -->
            <Border Background="White" CornerRadius="10" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="Novo Responsável" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#FF2D2D2D"/>
                    <TextBlock Text="Nome:"/>
                    <TextBox x:Name="txtNome" Margin="0,5,0,10"/>
                    <TextBlock Text="Cargo:"/>
                    <TextBox x:Name="txtCargo" Margin="0,5,0,10"/>

                    <Button Content="Salvar" Background="#27AE60" Foreground="White" BorderThickness="0" Height="35" Margin="0,10,0,0" Click="SalvarResponsavel"/>
                </StackPanel>
            </Border>

            <!-- Tabela -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="Lista de Responsáveis" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#FF2D2D2D"/>
                    <DataGrid x:Name="dgResponsaveis" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="150"/>
                            <DataGridTextColumn Header="Setor" Binding="{Binding Setor}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
        <Image HorizontalAlignment="Left" Height="61" Margin="-20,-20,0,0" VerticalAlignment="Top" Width="104" Source="/LogoArtG.jpeg" RenderTransformOrigin="-0.085,0.037" Grid.RowSpan="2"/>
    </Grid>
</Page>
