<Window x:Class="SistemaEstoque.CadastrarCategoriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cadastrar Categoria"
        Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF011945">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0">
            <Image HorizontalAlignment="Left"
                   Height="59"
                   Margin="-20,-20,0,0"
                   VerticalAlignment="Top"
                   Width="105"
                   Source="/LogoArtG.jpeg"/>
            <TextBlock Text="Cadastrar Categoria"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#FFABC2E4"
                       VerticalAlignment="Center"
                       Margin="120,0,0,0"/>
        </Grid>

        <!-- Conteúdo -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock Text="Descrição da Categoria" Foreground="#011945" FontWeight="Bold"/>
                <TextBox x:Name="txtDescricao" Height="30" Margin="0,5,0,15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Content="Salvar"
                            Width="100" Height="35"
                            Background="#27AE60"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            Click="Salvar_Click"/>
                    <Button Content="Cancelar"
                            Width="100" Height="35"
                            Background="#DC0000"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Cancelar_Click"/>
                </StackPanel>

                <Separator Margin="0,10,0,10"/>

                <TextBlock Text="Categorias Existentes"
                           Foreground="#011945"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                <DataGrid x:Name="dgCategorias"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Margin="0,5,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>