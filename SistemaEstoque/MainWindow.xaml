<Window x:Class="SistemaEstoque.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaEstoque"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#FF011945">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="67*"/>
            <ColumnDefinition Width="646*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FFADC1E4"
                   Margin="0,-2,0,12" Grid.ColumnSpan="3"><Run Language="pt-br" Text="&#x9;"/><Run Text=" Sistema de Gerenciamento de Estoque"/></TextBlock>

        <!-- Painel principal -->
        <Grid Grid.ColumnSpan="3" Margin="0,39,0,0" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Relatório semanal -->
            <Border Background="White" CornerRadius="10" Padding="15" Margin="5" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="📊 Relatório Semanal de Necessidades" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#FF2D2D2D"/>
                    <DataGrid x:Name="dgRelatorioSemanal" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Quantidade Atual" Binding="{Binding QuantidadeAtual}" Width="Auto"/>
                            <DataGridTextColumn Header="Necessário" Binding="{Binding QuantidadeNecessaria}" Width="Auto"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Painel lateral -->
            <Border Grid.Column="1" Margin="5" Background="White" CornerRadius="10" Padding="15">
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="🔧 Ações Rápidas" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#FF2D2D2D"/>

                    <Button Content="👤 Gerenciar Responsáveis" Margin="0,5" Height="40" Background="#3498DB" Foreground="White" BorderThickness="0" Click="AbrirResponsaveis_Click"/>
                    <Button Content="📦 Visualizar Estoque" Margin="0,5" Height="40" Background="#2ECC71" Foreground="White" BorderThickness="0" Click="AbrirEstoque_Click"/>

                    <Separator Margin="0,15"/>

                    <TextBlock Text="📈 Pré-visualização de Estoque" FontWeight="Bold" Margin="0,0,0,10" Foreground="#FF2D2D2D"/>
                    <ListView x:Name="lvPreviewEstoque" Height="127" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Produto" DisplayMemberBinding="{Binding Nome}" Width="150"/>
                                <GridViewColumn Header="Qtd" DisplayMemberBinding="{Binding Quantidade}" Width="60"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
        <Image HorizontalAlignment="Left" Height="61" Margin="-18,-18,0,0" VerticalAlignment="Top" Width="106" Grid.ColumnSpan="2" Source="/LogoArtG.jpeg" Grid.RowSpan="2"/>
    </Grid>
</Window>
