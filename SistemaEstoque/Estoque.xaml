<Page x:Class="SistemaEstoque.Estoque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SistemaEstoque"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Estoque" Height="450" Width="800" Background="#FF011945">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="Bold" Margin="0,-5,0,15" Foreground="#FFABC2E4" Background="#FF011945"><Run Language="pt-br" Text="&#x9;"/><Run Text=" Visualização do Estoque"/></TextBlock>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="txtBuscarProduto" Width="250" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Pesquisar" Width="100" Background="#2980B9" Foreground="White" BorderThickness="0" Click="Pesquisar"/>
                    <Button Content="Nova Entrada" Width="120" Margin="10,0,0,0" Background="#27AE60" Foreground="White" BorderThickness="0" Click="NovaEntrada"/>
                    <Button Content="Registrar Saída" Width="120" Margin="10,0,0,0" Background="#E67E22" Foreground="White" BorderThickness="0" Click="RegistrarSaida"/>
                </StackPanel>

                <DataGrid x:Name="dgEstoque" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                        <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="Auto"/>
                        <DataGridTextColumn Header="Entrada" Binding="{Binding DataEntrada}" Width="Auto"/>
                        <DataGridTextColumn Header="Saída" Binding="{Binding DataSaida}" Width="Auto"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        <Image HorizontalAlignment="Left" Height="59" Margin="-20,-20,0,0" VerticalAlignment="Top" Width="105" Source="/LogoArtG.jpeg" RenderTransformOrigin="-0.085,0.037"/>
    </Grid>
</Page>
